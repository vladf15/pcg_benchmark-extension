# Byte-compiled
__pycache__/
*.py[cod]

# Packaging
build/
dist/
.eggs/
*.egg-info/

# Environments
.env
.venv
env/
venv/

# Test and coverage
.pytest_cache/
.coverage
htmlcov/

# Type checkers
.mypy_cache/
.ruff_cache/

# Editors and OS
.vscode/
.idea/
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Training logs
*.log

# Training runs: the repository carries the loadable policies and nothing
# else.  final.zip, best/best_model.zip and the ckpt/ ladder can each be
# handed to load_policy and driven, so they are what a score can be traced
# back to and what would have to be retrained if lost.
#
# Tensorboard event logs are training telemetry, nothing a track score depends
# on, and their filenames carry the machine's hostname.  evaluations.npz is
# the training curve, also not something the simulation reads; re-include it
# with a "!" line if a chapter needs the plot.
model_training/runs/*/tb/
model_training/runs/*/eval/
events.out.tfevents.*

# Local working notes and planning documents, kept on disk, out of the repo.
CODE_GUIDE.md
model_training/PHYSICS_PLAN.md
model_training/TRAINING_PLAN.md

# Generated output.  Every one of these is rebuilt by a script in
# model_training/code, so the script is the thing worth versioning.
model_training/figures/
model_training/results/
model_training/renders/

# Reference circuit data: tracks/ is read by track_loader and is what every
# quality band was calibrated against, so it stays.  racelines/ is the
# minimum-curvature line and its plots, 12 MB that no code in this repository
# opens.
model_training/racetrack-database-master/racelines/
